{
  "$schema": "../schemas/cartridge-board.schema.json",
  "id": "nes.board.cnrom",
  "name": "CNROM",
  "mapper": 3,
  "components": [
    {
      "id": "mapper",
      "type": "ReusableMapperHardware",
      "role": "cnrom"
    }
  ],
  "connections": [
    "Cpu.Bus -> mapper.Cpu",
    "Ppu.Bus -> mapper.Ppu"
  ],
  "notes": "Composable CNROM board built from shared PRG, CHR, mirroring, RAM and IRQ components."
}
