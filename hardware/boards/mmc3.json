{
  "$schema": "../schemas/cartridge-board.schema.json",
  "id": "nes.board.mmc3",
  "name": "MMC3/MMC6",
  "mapper": 4,
  "components": [
    {
      "id": "mapper",
      "type": "ReusableMapperHardware",
      "role": "mmc3/mmc6"
    }
  ],
  "connections": [
    "Cpu.Bus -> mapper.Cpu",
    "Ppu.Bus -> mapper.Ppu"
  ],
  "notes": "Composable MMC3/MMC6 board built from shared PRG, CHR, mirroring, RAM and IRQ components."
}
